---
import type { Apartment } from '../data/apartments';
export interface Props {
  apartment: Apartment;
  lang: 'ro' | 'en';
}
const { apartment, lang } = Astro.props;
const href = lang === 'ro' ? `/ro/apartamente/${apartment.slug}/` : `/en/apartments/${apartment.slug}/`;
const features = apartment.features.slice(0, 4);
---

<a href={href} class="group overflow-hidden rounded-3xl border border-black/5 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus-ring block">
  <div class="aspect-[4/3] overflow-hidden bg-[var(--color-muted)]">
    <img
      src={apartment.images[0]}
      alt={lang === 'ro' ? apartment.name.ro : apartment.name.en}
      loading="lazy"
      decoding="async"
      width="800"
      height="600"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-serif text-lg font-semibold leading-tight">{lang === 'ro' ? apartment.name.ro : apartment.name.en}</h3>
      <span class="shrink-0 rounded-full bg-[var(--color-muted)] px-2.5 py-1 text-xs font-semibold">{apartment.zone[lang]}</span>
    </div>
    <p class="mt-1 text-sm text-[var(--color-text-muted)]">{apartment.excerpt[lang]}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {features.map((f) => (
        <span class="rounded-full bg-black/[0.04] px-2.5 py-1 text-xs">{f}</span>
      ))}
    </div>
    <div class="mt-4 flex items-center justify-between">
      <span class="text-sm">
        <span class="font-semibold">{lang==='ro'?'de la': 'from'} {apartment.priceFrom}{apartment.currency}</span>
        <span class="text-[var(--color-text-muted)]"> / {lang==='ro'?'noapte':'night'}</span>
      </span>
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)]">
        {lang==='ro'?'Detalii':'Details'} <span aria-hidden>→</span>
      </span>
    </div>
    <div class="mt-1 flex gap-3 text-xs text-[var(--color-text-muted)]">
      <span>{apartment.sizeM2}m²</span>·<span>{apartment.rooms} camere</span>·<span>max {apartment.maxGuests} pers</span>
    </div>
  </div>
</a>
