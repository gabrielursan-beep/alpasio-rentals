---
import { siteInfo } from '../data/apartments';
const year = new Date().getFullYear();
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'ro';
const t = lang === 'ro' ? {
  rights: 'Toate drepturile rezervate.',
  phone: 'Telefon',
  email: 'Email',
  address: 'Adresă',
  follow: 'Ne găsești și pe',
  cards: 'Acceptăm carduri de vacanță',
  legal: 'Informații legale',
  privacy: 'Confidențialitate',
  cookies: 'Cookies',
  terms: 'Termeni',
  booking: 'Rezervare și anulare',
  rules: 'Regulament cazare',
} : {
  rights: 'All rights reserved.',
  phone: 'Phone',
  email: 'Email',
  address: 'Address',
  follow: 'Find us on',
  cards: 'We accept vacation cards',
  legal: 'Legal',
  privacy: 'Privacy',
  cookies: 'Cookies',
  terms: 'Terms',
  booking: 'Booking policy',
  rules: 'House rules',
};
---

<footer class="mt-16 border-t border-black/5 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="font-serif text-lg font-bold text-[var(--color-secondary)]">Alpasio</span>
          <span class="rounded bg-[var(--color-primary)] px-1.5 py-0.5 text-xs font-semibold uppercase tracking-widest text-white">Rentals</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
          {lang === 'ro'
            ? 'Apartamente în regim hotelier în Galați. Curățenie, confort și transparență pentru delegații, familii și șederi scurte.'
            : 'Serviced apartments in Galati. Clean, comfortable and transparent for business, families and short stays.'}
        </p>
        <div class="mt-4 flex gap-2">
          <a href={siteInfo.facebook} target="_blank" rel="noopener" class="rounded-full border border-black/10 p-2 hover:bg-black/5" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V3h-3c-2.76 0-5 2.24-5 5v3H6v5h3v5h5v-5h3l1-5h-4V8c0-.55.45-1 1-1z"/></svg>
          </a>
          <a href={siteInfo.instagram} target="_blank" rel="noopener" class="rounded-full border border-black/10 p-2 hover:bg-black/5" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-sm uppercase tracking-widest text-[var(--color-text-muted)]">Contact</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={siteInfo.phoneHref} class="font-medium hover:underline focus-ring rounded">{siteInfo.phone}</a> <span class="text-xs text-[var(--color-text-muted)]">/ WhatsApp</span></li>
          <li><a href={siteInfo.emailHref} class="hover:underline focus-ring rounded">{siteInfo.email}</a></li>
          <li class="text-[var(--color-text-muted)]">{siteInfo.address}</li>
          <li class="text-xs">Check-in {siteInfo.checkIn} · Check-out {siteInfo.checkOut}</li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-sm uppercase tracking-widest text-[var(--color-text-muted)]">{t.legal}</h3>
        <ul class="mt-3 space-y-1.5 text-sm">
          <li><a href={lang==='ro'?'/ro/politica-confidentialitate/':'/en/privacy/'} class="hover:underline">{t.privacy}</a></li>
          <li><a href={lang==='ro'?'/ro/politica-cookies/':'/en/cookies/'} class="hover:underline">{t.cookies}</a></li>
          <li><a href={lang==='ro'?'/ro/termeni-si-conditii/':'/en/terms/'} class="hover:underline">{t.terms}</a></li>
          <li><a href={lang==='ro'?'/ro/politica-rezervare-anulare/':'/en/booking-policy/'} class="hover:underline">{t.booking}</a></li>
          <li><a href={lang==='ro'?'/ro/regulament-cazare/':'/en/house-rules/'} class="hover:underline">{t.rules}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-sm uppercase tracking-widest text-[var(--color-text-muted)]">{t.cards}</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full border border-black/10 bg-white px-3 py-1 text-xs font-semibold">Edenred</span>
          <span class="rounded-full border border-black/10 bg-white px-3 py-1 text-xs font-semibold">Up</span>
          <span class="rounded-full border border-black/10 bg-white px-3 py-1 text-xs font-semibold">Pluxee</span>
        </div>
        <p class="mt-2 text-xs text-[var(--color-text-muted)]">
          {lang==='ro' ? 'Plata la locație sau online. Detalii pe pagina dedicată.' : 'Pay on location or online. See dedicated page.'}
        </p>
        <a href={lang==='ro'?'/ro/carduri-vacanta/':'/en/vacation-cards/'} class="mt-2 inline-flex text-xs font-semibold text-[var(--color-primary)] hover:underline">
          {lang==='ro'?'Cum plătesc →':'How to pay →'}
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-black/5 pt-6 text-xs text-[var(--color-text-muted)] md:flex-row md:justify-between">
      <span>© {year} Alpasio Rentals. {t.rights}</span>
      <span class="text-[11px]">{lang==='ro' ? 'Date firmă [de confirmat] · Preview neindexabil' : 'Company data [to confirm] · Preview noindex'}</span>
    </div>
  </div>

  <!-- sticky CTA mobile -->
  <div class="fixed inset-x-0 bottom-0 z-30 flex gap-2 border-t border-black/10 bg-white p-2 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] md:hidden">
    <a href={siteInfo.phoneHref} class="flex-1 rounded-full bg-[var(--color-secondary)] py-3 text-center text-sm font-semibold text-white">Suna</a>
    <a href={siteInfo.whatsapp} target="_blank" rel="noopener" class="flex-1 rounded-full bg-[#25D366] py-3 text-center text-sm font-semibold text-white">WhatsApp</a>
    <a href={lang==='ro'?'/ro/contact/':'/en/contact/'} class="flex-1 rounded-full bg-[var(--color-primary)] py-3 text-center text-sm font-semibold text-white">Rezervă</a>
  </div>
</footer>
