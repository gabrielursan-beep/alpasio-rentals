---
export interface Props {
  lang: 'ro' | 'en';
  currentPath: string;
}
const { lang, currentPath } = Astro.props;

const nav = lang === 'ro'
  ? [
      { href: '/ro/', label: 'Acasă' },
      { href: '/ro/apartamente/', label: 'Apartamente' },
      { href: '/ro/carduri-vacanta/', label: 'Carduri vacanță' },
      { href: '/ro/intrebari-frecvente/', label: 'Întrebări' },
      { href: '/ro/blog/', label: 'Blog' },
      { href: '/ro/contact/', label: 'Contact' },
    ]
  : [
      { href: '/en/', label: 'Home' },
      { href: '/en/apartments/', label: 'Apartments' },
      { href: '/en/vacation-cards/', label: 'Vacation cards' },
      { href: '/en/faq/', label: 'FAQ' },
      { href: '/en/blog/', label: 'Blog' },
      { href: '/en/contact/', label: 'Contact' },
    ];

const switchLang = lang === 'ro'
  ? currentPath.replace(/^\/ro/, '/en').replace('/apartamente/', '/apartments/').replace('/carduri-vacanta/', '/vacation-cards/').replace('/intrebari-frecvente/', '/faq/')
  : currentPath.replace(/^\/en/, '/ro').replace('/apartments/', '/apartamente/').replace('/vacation-cards/', '/carduri-vacanta/').replace('/faq/', '/intrebari-frecvente/');

const otherLangLabel = lang === 'ro' ? 'EN' : 'RO';
---

<header class="sticky top-0 z-40 border-b border-black/5 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
    <a href={lang === 'ro' ? '/ro/' : '/en/'} class="flex items-center gap-2 focus-ring rounded">
      <span class="font-serif text-xl font-bold tracking-tight text-[var(--color-secondary)]">Alpasio</span>
      <span class="rounded bg-[var(--color-primary)] px-1.5 py-0.5 text-xs font-semibold uppercase tracking-widest text-white">Rentals</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "rounded-full px-3 py-1.5 text-sm font-medium transition",
            currentPath === item.href || currentPath.startsWith(item.href + (item.href.endsWith('/') ? '' : '/'))
              ? "bg-[var(--color-secondary)] text-white"
              : "text-[var(--color-text-muted)] hover:bg-black/5 hover:text-[var(--color-text)]"
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={switchLang} class="rounded-full border border-black/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-widest hover:bg-black/5 focus-ring" aria-label={`Switch to ${otherLangLabel}`}>
        {otherLangLabel}
      </a>
      <a href={lang === 'ro' ? '/ro/contact/' : '/en/contact/'} class="hidden rounded-full bg-[var(--color-primary)] px-4 py-1.5 text-sm font-semibold text-white hover:bg-[var(--color-primary-hover)] focus-ring md:inline-flex">
        {lang === 'ro' ? 'Rezervă' : 'Book'}
      </a>
      <!-- mobile menu button simple -->
      <details class="relative md:hidden">
        <summary class="list-none rounded-full border border-black/10 p-2 focus-ring cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-black/10 bg-white p-2 shadow-xl">
          {nav.map((item) => (
            <a href={item.href} class="block rounded-xl px-3 py-2 text-sm hover:bg-black/5">{item.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
