---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const canonical='https://alpasio-rentals-preview.ursan.org/en/house-rules/';
---
<Base title="house-rules | Alpasio Rentals" description="Draft house-rules" lang="en" canonical={canonical} noindex={true}>
  <Header lang="en" currentPath="/en/house-rules/" />
  <main id="main" class="mx-auto max-w-3xl px-4 py-8 md:px-6">
    <h1 class="font-serif text-3xl font-bold">house-rules</h1>
    <p class="mt-2 text-xs bg-amber-100 inline-flex px-2 py-1 rounded-full font-semibold">Draft - to confirm</p>
    <p class="mt-4 text-sm text-[var(--color-text-muted)]">Placeholder legal page, needs verification.</p>
  </main>
  <Footer />
</Base>
