---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { siteInfo } from '../../../data/apartments';
const title='Contact Alpasio Rentals Galati';
const description='Contact Alpasio Rentals: phone +40 743 684 327, email, availability request.';
const canonical='https://alpasio-rentals-preview.ursan.org/en/contact/';
---
<Base title={title} description={description} lang="en" canonical={canonical} hreflang={{ ro: canonical.replace('/en/contact/','/ro/contact/'), en: canonical }}>
  <Header lang="en" currentPath="/en/contact/" />
  <main id="main" class="mx-auto max-w-xl px-4 py-8 md:px-6">
    <h1 class="font-serif text-3xl font-bold">Contact us</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">Phone <a href={siteInfo.phoneHref} class="underline">{siteInfo.phone}</a> · <a href={siteInfo.emailHref} class="underline">{siteInfo.email}</a></p>
    <a href="/ro/contact/" class="mt-4 inline-flex rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-white">Go to Romanian contact form</a>
  </main>
  <Footer />
</Base>
