---
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
const title='Draft cum-alegi-apartament-galati | Alpasio Rentals';
const description='Draft articol cum-alegi-apartament-galati - de completat cu cercetare locală.';
const canonical='https://alpasio-rentals-preview.ursan.org/ro/blog/cum-alegi-apartament-galati/';
---
<Base title={title} description={description} lang="ro" canonical={canonical} noindex={true}>
  <Header lang="ro" currentPath="/ro/blog/" />
  <main id="main" class="mx-auto max-w-3xl px-4 py-8 md:px-6">
    <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-800">Draft</span>
    <h1 class="mt-2 font-serif text-2xl font-bold">Draft: cum-alegi-apartament-galati</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">Acest articol este placeholder pentru strategia de conținut. Va fi completat cu keyphrase, H1-H3, meta, legături interne și FAQ, pe baza cercetării SEO locale.</p>
    <a href="/ro/blog/" class="mt-4 inline-flex text-sm font-semibold text-[var(--color-primary)]">← Înapoi la blog</a>
  </main>
  <Footer />
</Base>
