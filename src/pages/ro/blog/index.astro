---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const posts = [
  { slug: 'locuri-de-vizitat-galati', title: 'Locuri de vizitat în Galați', date: '06/02/2023', excerpt: 'Faleza Dunării, Turnul TV, Complexul Muzeal Răsvan Angheluță și alte locuri emblematice.' },
  { slug: 'restaurante-galati', title: 'Cele mai bune restaurante din Galați', date: '11/10/2022', excerpt: 'Top 10 restaurante: Blue Acqua, Teatris, Gaffino, Libertatea și altele.' },
  { slug: 'cum-alegi-apartament-galati', title: 'Cum alegi un apartament în regim hotelier în Galați', date: '25/08/2026', excerpt: 'Ghid practic pentru delegații și familii. [Draft]', draft: true },
  { slug: 'cazare-delegatii-galati', title: 'Cazare pentru delegații și companii în Galați', date: '25/08/2026', excerpt: 'Factură, parcare, WiFi și check-in flexibil. [Draft]', draft: true },
  { slug: 'ghid-galati', title: 'Ghidul orașului Galați', date: '25/08/2026', excerpt: 'Ce vezi, unde mănânci, unde te cazezi lângă Faleză. [Draft]', draft: true },
  { slug: 'plata-card-vacanta', title: 'Cum plătești cazarea cu cardul de vacanță', date: '25/08/2026', excerpt: 'Edenred, Up, Pluxee: proces și condiții. [Draft]', draft: true },
  { slug: 'apartament-vs-hotel', title: 'Apartament în regim hotelier vs hotel', date: '25/08/2026', excerpt: 'Intimitate, bucătărie, preț per apartament. [Draft]', draft: true },
  { slug: 'cazare-acces-rapid-galati', title: 'Unde te cazezi pentru acces rapid în Galați', date: '25/08/2026', excerpt: 'Tribunal, Faleză, City Mall. [Draft]', draft: true },
];
const title='Blog Alpasio Rentals | Ghiduri Galați';
const description='Articole despre Galați, cazare și tips pentru oaspeți. 2 articole migrate + 6 ghiduri noi.';
const canonical='https://alpasio-rentals-preview.ursan.org/ro/blog/';
---
<Base title={title} description={description} lang="ro" canonical={canonical} hreflang={{ ro: canonical, en: canonical.replace('/ro/blog/','/en/blog/') }}>
  <Header lang="ro" currentPath="/ro/blog/" />
  <main id="main" class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    <h1 class="font-serif text-3xl font-bold">Blog</h1>
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">Ghiduri locale și sfaturi pentru șederea în Galați.</p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {posts.map(p => (
        <a href={`/ro/blog/${p.slug}/`} class="rounded-3xl border border-black/5 bg-white p-5 hover:shadow-md transition block">
          <div class="text-xs text-[var(--color-text-muted)]">{p.date} {p.draft && '· Draft'}</div>
          <h2 class="mt-1 font-semibold">{p.title}</h2>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">{p.excerpt}</p>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Base>
