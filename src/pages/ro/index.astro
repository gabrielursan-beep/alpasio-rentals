---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ApartmentCard from '../../components/ApartmentCard.astro';
import { apartments, siteInfo } from '../../data/apartments';

const title = 'Apartamente în regim hotelier Galați | Alpasio Rentals';
const description = 'Apartamente curate și moderne în Galați, pentru delegații, familii și șederi scurte. 2 apartamente 54m², WiFi, parcare, bucătărie utilată, carduri de vacanță. De la 51€/noapte.';
const canonical = 'https://alpasio-rentals-preview.ursan.org/ro/';
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LodgingBusiness",
      "@id": canonical + "#business",
      "name": "Alpasio Rentals",
      "url": canonical,
      "description": description,
      "telephone": siteInfo.phone,
      "email": siteInfo.email,
      "address": { "@type": "PostalAddress", "addressLocality": "Galați", "addressCountry": "RO" },
      "priceRange": "€€",
      "amenityFeature": apartments[0].features.map(f => ({ "@type": "LocationFeatureSpecification", "name": f, "value": true }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Acasă", "item": canonical }]
    }
  ]
};
---

<Base title={title} description={description} lang="ro" canonical={canonical} hreflang={{ ro: canonical, en: canonical.replace('/ro/','/en/') }} schema={schema}>
  <Header lang="ro" currentPath="/ro/" />
  <main id="main">
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 py-8 md:px-6 md:py-12">
      <div class="grid gap-8 md:grid-cols-12 md:items-center">
        <div class="md:col-span-6">
          <p class="inline-flex rounded-full bg-[var(--color-muted)] px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[var(--color-secondary)]">Galați · din 2022</p>
          <h1 class="mt-3 font-serif text-4xl font-bold leading-[0.95] md:text-5xl">
            Dă liniștea <span class="text-[var(--color-primary)]">mai tare.</span> Alege să ne fii oaspete.
          </h1>
          <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[var(--color-text-muted)]">
            Apartamente în regim hotelier, gândite pentru intimitate și confort. Bucătărie complet utilată, WiFi rapid, parcare și balcon. Factură pentru companii și plată cu carduri de vacanță (Edenred, Up, Pluxee).
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/ro/apartamente/" class="rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-white hover:bg-[var(--color-primary-hover)] focus-ring">Vezi apartamentele</a>
            <a href="/ro/contact/" class="rounded-full border border-black/10 bg-white px-6 py-3 text-sm font-semibold hover:bg-black/5 focus-ring">Verifică disponibilitate</a>
          </div>
          <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-black/5 pt-6 text-sm">
            <div><dt class="font-semibold">4 apartamente</dt><dd class="text-xs text-[var(--color-text-muted)]">2 active acum</dd></div>
            <div><dt class="font-semibold">5★ pe Booking</dt><dd class="text-xs text-[var(--color-text-muted)]">recenzii reale</dd></div>
            <div><dt class="font-semibold">24/7</dt><dd class="text-xs text-[var(--color-text-muted)]">suport telefonic</dd></div>
          </dl>
        </div>
        <div class="md:col-span-6">
          <div class="relative overflow-hidden rounded-[2rem] bg-black/5">
            <img src={apartments[0].images[0]} alt="Living Alpasio M19" width="1200" height="800" loading="eager" fetchpriority="high" decoding="async" class="h-[420px] w-full object-cover md:h-[520px]" />
            <div class="absolute bottom-3 left-3 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold shadow">De la 51€ / noapte · 54m² · 4 pers</div>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-2">
            <img src={apartments[1].images[0]} alt="Apartament M2" width="400" height="300" loading="lazy" class="h-24 w-full rounded-2xl object-cover" />
            <img src={apartments[0].images[1]} alt="Detaliu M19" width="400" height="300" loading="lazy" class="h-24 w-full rounded-2xl object-cover" />
            <img src={apartments[1].images[1]} alt="Detaliu M2" width="400" height="300" loading="lazy" class="h-24 w-full rounded-2xl object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
        <h2 class="font-serif text-2xl font-semibold">Gândit pentru cei care își doresc intimitate și confort</h2>
        <p class="mt-2 max-w-2xl text-sm text-[var(--color-text-muted)]">Conceptul Alpasio a prins contur ca să te simți ca acasă, fie că ești în vacanță sau delegație. Fără recepție aglomerată, cu chei predate personal și suport la telefon.</p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl border border-black/5 p-5">
            <h3 class="font-semibold">Curățenie impecabilă</h3>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">Lenjerie proaspătă, baie curată, bucătărie utilată complet. Verificat la fiecare check-out.</p>
          </div>
          <div class="rounded-2xl border border-black/5 p-5">
            <h3 class="font-semibold">Locații centrale</h3>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">Faleză la 2 pași (M19) și Tribunal la 10 min de centru (M2). Transport și magazine aproape.</p>
          </div>
          <div class="rounded-2xl border border-black/5 p-5">
            <h3 class="font-semibold">Flexibil pentru companii</h3>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">Factură, plată cu card vacanță, ședere lungă, check-in 14:00 / out 12:00 cu prelungire la cerere.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Apartments -->
    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-serif text-2xl font-semibold">Apartamentele Alpasio</h2>
        <a href="/ro/apartamente/" class="text-sm font-semibold text-[var(--color-primary)] hover:underline">Vezi toate →</a>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {apartments.map((ap) => <ApartmentCard apartment={ap} lang="ro" />)}
      </div>
      <div class="mt-6 rounded-2xl border border-dashed border-black/10 bg-white p-5 text-sm">
        <p class="font-semibold">În curând: Aparterm (parter, aproape de Kaufland/Altex, Spitalul Județean) și P8 (central, etaj 1 cu lift, AC).</p>
        <p class="text-[var(--color-text-muted)]">Lasă-ne un mesaj ca să te anunțăm la lansare.</p>
      </div>
    </section>

    <!-- Trust & CTA -->
    <section class="bg-[var(--color-secondary)] text-white">
      <div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <h2 class="font-serif text-2xl font-semibold">Ai întrebări? Îți răspundem rapid.</h2>
            <p class="mt-1 text-sm text-white/70">Telefon, WhatsApp sau formular. Răspuns în cel mai scurt timp.</p>
          </div>
          <div class="flex gap-3">
            <a href={siteInfo.phoneHref} class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-[var(--color-secondary)] hover:bg-white/90 focus-ring">Sună {siteInfo.phone}</a>
            <a href="/ro/contact/" class="rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 focus-ring">Contactează-ne</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
