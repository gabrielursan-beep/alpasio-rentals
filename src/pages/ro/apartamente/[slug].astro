---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Gallery from '../../../components/Gallery.astro';
import { apartments, siteInfo } from '../../../data/apartments';

export function getStaticPaths() {
  return apartments.map(ap => ({ params: { slug: ap.slug } }));
}

const { slug } = Astro.params;
const ap = apartments.find(a => a.slug === slug);
if (!ap) return Astro.redirect('/ro/apartamente/');

const lang = 'ro';
const canonical = `https://alpasio-rentals-preview.ursan.org/ro/apartamente/${ap.slug}/`;
const title = `${ap.name.ro} de închiriat în regim hotelier Galați | Alpasio Rentals`;
const description = `${ap.excerpt.ro} De la ${ap.priceFrom}${ap.currency}/noapte. ${ap.sizeM2}m², ${ap.rooms} camere, max ${ap.maxGuests} persoane. Check-in ${siteInfo.checkIn}, check-out ${siteInfo.checkOut}.`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LodgingBusiness",
      "name": ap.name.ro,
      "description": description,
      "url": canonical,
      "telephone": siteInfo.phone,
      "address": { "@type": "PostalAddress", "addressLocality": "Galați", "addressCountry": "RO", "streetAddress": ap.address.ro },
      "amenityFeature": ap.features.map(f => ({ "@type": "LocationFeatureSpecification", "name": f, "value": true })),
      "numberOfRooms": ap.rooms,
      "floorSize": { "@type": "QuantitativeValue", "value": ap.sizeM2, "unitCode": "MTK" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Acasă", "item": "https://alpasio-rentals-preview.ursan.org/ro/" },
        { "@type": "ListItem", "position": 2, "name": "Apartamente", "item": "https://alpasio-rentals-preview.ursan.org/ro/apartamente/" },
        { "@type": "ListItem", "position": 3, "name": ap.name.ro, "item": canonical }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Cum fac check-in?", "acceptedAnswer": { "@type": "Answer", "text": `Check-in de la ${siteInfo.checkIn}, cu 30 min anunț telefonic. Cheile se predau la locație după preluarea datelor.` } },
        { "@type": "Question", "name": "Pot plăti cu card de vacanță?", "acceptedAnswer": { "@type": "Answer", "text": "Da, acceptăm Edenred, Up și Pluxee (fost Sodexo). Vezi pagina Carduri de vacanță pentru detalii." } }
      ]
    }
  ]
};
---

<Base title={title} description={description} lang={lang} canonical={canonical} hreflang={{ ro: canonical, en: canonical.replace('/ro/apartamente/','/en/apartments/') }} schema={schema} ogImage={ap.images[0]}>
  <Header lang="ro" currentPath={`/ro/apartamente/${ap.slug}/`} />
  <main id="main" class="mx-auto max-w-6xl px-4 py-6 md:px-6">
    <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-text-muted)]"><a href="/ro/" class="hover:underline">Acasă</a> <span>›</span> <a href="/ro/apartamente/" class="hover:underline">Apartamente</a> <span>›</span> {ap.name.ro}</nav>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="font-serif text-3xl font-bold">{ap.name.ro}</h1>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">{ap.address.ro} · {ap.floor} · {ap.sizeM2}m² · {ap.rooms} camere · {ap.bathrooms} baie · max {ap.maxGuests} pers</p>
      </div>
      <div class="rounded-full bg-[var(--color-primary)] px-4 py-2 text-sm font-semibold text-white">de la {ap.priceFrom}{ap.currency} / noapte</div>
    </div>

    <div class="mt-6">
      <Gallery images={ap.images} alt={ap.name.ro} />
    </div>

    <div class="mt-8 grid gap-8 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="leading-relaxed">{ap.description.ro}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {ap.highlights.map(h => <span class="rounded-full bg-[var(--color-muted)] px-3 py-1 text-xs font-semibold">{h.ro}</span>)}
        </div>

        <h2 class="mt-8 font-serif text-xl font-semibold">Caracteristici</h2>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
          {ap.features.map(f => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>{f}</li>)}
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>Check-in {siteInfo.checkIn} · Check-out {siteInfo.checkOut}</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>{ap.beds} paturi · {ap.sizeM2}m²</li>
          <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]"></span>Cafea și ceai incluse</li>
        </ul>

        <div class="mt-6 rounded-2xl border border-black/5 bg-white p-5">
          <h3 class="font-semibold">Locație</h3>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">{ap.address.ro}</p>
          <a href={ap.mapLink} target="_blank" rel="noopener" class="mt-3 inline-flex rounded-full border border-black/10 px-4 py-2 text-sm font-semibold hover:bg-black/5">Vezi pe hartă →</a>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">Harta interactivă se încarcă doar la click (GDPR friendly). Pentru indicații exacte sună la {siteInfo.phone}.</p>
        </div>

        <div class="mt-6 rounded-2xl bg-[var(--color-muted)] p-5">
          <h3 class="font-semibold">Acceptăm carduri de vacanță</h3>
          <p class="mt-1 text-sm">Edenred, Up și Pluxee (fost Sodexo). <a href="/ro/carduri-vacanta/" class="font-semibold text-[var(--color-primary)] hover:underline">Cum plătesc?</a></p>
        </div>
      </div>

      <aside class="md:col-span-4">
        <div class="sticky top-20 rounded-3xl border border-black/5 bg-white p-5 shadow-sm">
          <h3 class="font-serif text-lg font-semibold">Solicită disponibilitate</h3>
          <p class="mt-1 text-xs text-[var(--color-text-muted)]">Răspundem rapid pe telefon sau email.</p>
          <div class="mt-4 grid gap-2">
            <a href={siteInfo.phoneHref} class="rounded-full bg-[var(--color-secondary)] py-3 text-center text-sm font-semibold text-white hover:bg-black focus-ring">Sună {siteInfo.phone}</a>
            <a href={siteInfo.whatsapp} target="_blank" rel="noopener" class="rounded-full bg-[#25D366] py-3 text-center text-sm font-semibold text-white focus-ring">WhatsApp</a>
            <a href="/ro/contact/" class="rounded-full border border-black/10 py-3 text-center text-sm font-semibold hover:bg-black/5 focus-ring">Formular rezervare</a>
          </div>
          <ul class="mt-4 space-y-1 text-xs text-[var(--color-text-muted)]">
            <li>• Anulare gratuită cu 24h înainte</li>
            <li>• Fumat doar pe balcon</li>
            <li>• Parcare nerezervată, lift, balcon</li>
            <li>• Factură pentru companii</li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Base>
